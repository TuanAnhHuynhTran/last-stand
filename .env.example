# =========================
# CITYVERSE ENVIRONMENT
# =========================

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (MySQL 8)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cityverse
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_LOGGING=false

# JWT Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-access-secret-key-cityverse
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-refresh-secret-key-cityverse
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# Dev No-DB / Auto Admin Mode (set to false once MySQL & login flow are ready)
DEV_AUTO_ADMIN=true
DB_FALLBACK_SQLITE=true

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_AUTO_ADMIN_LOGIN=true
